# Copie para .env e ajuste se necessário. Nenhum valor real de segredo deve ser versionado.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=web,127.0.0.1,localhost
# DJANGO_SECRET_KEY=   # se vazio, a API gera e persiste uma chave em /app/data/secret_key.txt

# Base de conhecimento (docs/conhecimento/README.md)
# Token fine-grained do GitHub só com "Contents: Read-only" nos repositórios autorizados.
GITHUB_TOKEN_LEITURA=
EMBEDDINGS_MODELO=bge-m3
